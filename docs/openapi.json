  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "secondName": {
            "type": "string"
          },
          "inn": {
            "type": "string"
          },
          "ogrn": {
            "type": "string"
          },
          "okved": {
            "type": "string"
          },
          "organizationType": {
            "type": "string",
            "enum": [
              "OOO",
              "IP",
              "AO"
            ]
          },
          "registrationDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "login",
          "password",
          "firstName",
          "lastName",
          "secondName",
          "inn",
          "ogrn",
          "okved",
          "organizationType",
          "registrationDate"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "secondName": {
            "type": "string"
          },
          "inn": {
            "type": "string"
          },
          "ogrn": {
            "type": "string"
          },
          "okved": {
            "type": "string"
          },
          "organizationType": {
            "type": "string",
            "enum": [
              "OOO",
              "IP",
              "AO"
            ]
          },
          "registrationDate": {
            "type": "string",
            "format": "date"
          },
          "client_id": {
            "type": "integer",
            "format": "int64"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "purposes": {
            "type": "string"
          },
          "mainDifference": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "interest": {
            "type": "number"
          },
          "discountInterest": {
            "type": "number"
          },
          "discountConditions": {
            "type": "string",
            "nullable": true
          },
          "minSum": {
            "type": "integer"
          },
          "maxSum": {
            "type": "integer"
          },
          "minDurationYear": {
            "type": "integer"
          },
          "maxDurationYear": {
            "type": "integer"
          },
          "repaymentTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "EQUAL_TOTAL_PARTS",
                "EQUAL_PRINCIPAL_PARTS"
              ]
            }
          }
        }
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        },
        "required": [
          "products"
        ]
      },
      "CalculatorRequest": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "number",
            "minimum": 0.01,
            "description": "Обязательно без productId; с продуктом ставка берётся из каталога."
          },
          "amount": {
            "type": "number",
            "minimum": 1000
          },
          "durationYears": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "organizationType": {
            "type": "string",
            "enum": [
              "OOO",
              "IP",
              "AO"
            ]
          },
          "collateral": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "amount",
          "durationYears",
          "organizationType",
          "collateral",
          "purpose"
        ]
      },
